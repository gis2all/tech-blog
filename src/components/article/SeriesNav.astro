---
import { getPostSlug, getSeriesPosts, type PostLike } from "../../lib/content/posts";

type Props = {
  posts: PostLike[];
  seriesSlug?: string;
  currentSlug: string;
  title?: string;
  description?: string;
};

const { posts, seriesSlug, currentSlug, title, description } = Astro.props;
const seriesPosts = seriesSlug ? getSeriesPosts(posts, seriesSlug) : [];
---

{seriesSlug && seriesPosts.length > 0 && (
  <aside class="panel series-nav">
    <div class="series-head">
      <span class="kicker">SERIES</span>
      <h2>{title ?? "专题"}</h2>
      {description && <p>{description}</p>}
    </div>
    <div class="series-list">
      {seriesPosts.map((post, index) => {
        const slug = getPostSlug(post);
        return (
          <a class:list={{ active: slug === currentSlug }} href={`/posts/${slug}/`}>
            <b>{String(index + 1).padStart(2, "0")}</b>
            <span>{post.data.title}</span>
          </a>
        );
      })}
    </div>
  </aside>
)}
