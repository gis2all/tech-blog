---
import ArticleMeta from "../components/article/ArticleMeta.astro";
import ArticleReadProgress from "../components/article/ArticleReadProgress.astro";
import RelatedPosts from "../components/article/RelatedPosts.astro";
import GiscusComments from "../components/article/GiscusComments.astro";
import ArticleToc from "../components/article/ArticleToc.astro";
import ArticleTocButton from "../components/article/ArticleTocButton.astro";
import AuthorAvatar from "../components/common/AuthorAvatar.astro";
import DiscoveryRail from "../components/layout/DiscoveryRail.astro";
import FeaturedTagRail from "../components/layout/FeaturedTagRail.astro";
import RecentReading from "../components/layout/RecentReading.astro";
import BaseLayout from "./BaseLayout.astro";
import type { SeriesEntry } from "../lib/content/queries";
import {
  calculateReadingTime,
  getAdjacentPosts,
  getPostSlug,
  getRelatedPosts,
  type PostLike
} from "../lib/content/posts";
import { site } from "../lib/site";

type Props = {
  post: PostLike;
  allPosts: PostLike[];
  allSeries: SeriesEntry[];
  headings: { depth: number; slug: string; text: string }[];
};

const { post, allPosts, allSeries, headings } = Astro.props;
const published = post.data.publishedAt.toISOString().slice(0, 10);
const updated = "updatedAt" in post.data && post.data.updatedAt instanceof Date
  ? post.data.updatedAt.toISOString().slice(0, 10)
  : undefined;
const currentSlug = getPostSlug(post);
const readingTime = calculateReadingTime(post.body);
const { previous, next } = getAdjacentPosts(allPosts, currentSlug);
const relatedPosts = getRelatedPosts(allPosts, post, 4);
const hasVisibleHeadings = headings.some((heading) => heading.depth <= 3);
const articleUrl = new URL(`/posts/${currentSlug}/`, site.url).toString();
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  url: articleUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl
  },
  author: {
    "@type": "Person",
    name: site.author,
    url: site.githubUrl
  },
  publisher: {
    "@type": "Person",
    name: site.author,
    url: site.url
  },
  articleSection: post.data.category,
  keywords: post.data.tags?.join(", "),
  ...(post.data.cover
    ? { image: new URL(post.data.cover, site.url).toString() }
    : {})
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  image={post.data.cover}
  jsonLd={articleJsonLd}
>
  <ArticleTocButton slot="header-actions" headings={headings} />
  <main id="main-content" class="wrap article-shell">
    <DiscoveryRail
      posts={allPosts}
      allSeries={allSeries}
      mode="article"
      currentCategory={post.data.category}
      currentSeries={post.data.series}
    />
    <div class="article-main">
    <article
      class="panel article-page"
      data-article-view
      data-reading-article
      data-reading-slug={currentSlug}
      data-reading-url={`/posts/${currentSlug}/`}
      data-reading-title={post.data.title}
      data-reading-category={post.data.category}
    >
      <header class="article-head">
        <span class="kicker">{post.data.category}</span>
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.description}</p>
        <div class="byline">
          <AuthorAvatar size="mini" decorative />
          <div>
            <b>{site.author}</b>
            <div>{published} 发布{updated && ` · ${updated} 更新`} · {readingTime} 分钟阅读</div>
          </div>
        </div>
        <ArticleMeta
          post={post}
          showCategory={false}
          showDate={false}
          showReadingTime={false}
          tagLimit={8}
        />
      </header>
      <div class="prose" data-pagefind-body>
        <slot />
      </div>
      {"changelog" in post.data && Array.isArray(post.data.changelog) && post.data.changelog.length > 0 && (
        <section class="changelog">
          <h2>更新记录</h2>
          {post.data.changelog.map((item) => (
            <div class="change">
              <time datetime={item.date.toISOString()}>{item.date.toISOString().slice(0, 10)}</time>
              <span>{item.note}</span>
            </div>
          ))}
        </section>
      )}
      <footer class="article-footer">
        <RelatedPosts posts={relatedPosts} />
        {(previous || next) && (
          <nav class="post-navigation" aria-label="相邻文章">
            {previous && (
              <a class="post-navigation-item" href={`/posts/${getPostSlug(previous)}/`}>
                <small>上一篇</small>
                <strong>{previous.data.title}</strong>
              </a>
            )}
            {next && (
              <a class="post-navigation-item next" href={`/posts/${getPostSlug(next)}/`}>
                <small>下一篇</small>
                <strong>{next.data.title}</strong>
              </a>
            )}
          </nav>
        )}
        <section class="author-note" aria-label="作者说明">
          <AuthorAvatar size="mini" decorative />
          <div>
            <h2>{site.author} · {site.title}</h2>
            <p>记录编程、AI 与工程实践，保留问题、判断与复盘过程。</p>
          </div>
        </section>
        <GiscusComments />
      </footer>
    </article>
    <section class="panel article-filter-page" data-article-filter-view hidden aria-live="polite">
      <div class="section-title home-feed-head">
        <h1 data-article-filter-title>文章列表</h1>
        <small data-article-filter-count></small>
      </div>
      <div data-article-filter-list></div>
      <p class="article-filter-empty" data-article-filter-empty hidden>该筛选下暂无文章</p>
    </section>
    </div>
    <div class="article-right">
      <div class="stack" data-article-toc-view>
        {hasVisibleHeadings ? (
          <ArticleToc headings={headings} />
        ) : (
          <ArticleReadProgress standalone />
        )}
        <RecentReading variant="article" excludeSlug={currentSlug} />
      </div>
      <div data-article-discovery-view hidden>
        <FeaturedTagRail posts={allPosts} />
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import "../scripts/article-discovery-filter";
  import "../scripts/lazy-article-videos";
</script>
