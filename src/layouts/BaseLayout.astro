---
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import { getUmamiWebsiteId } from "../lib/analytics/umami";
import { site } from "../lib/site";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title = site.title,
  description = site.description,
  noindex = false,
  ogType = "website",
  image,
  jsonLd
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const absoluteImage = image ? new URL(image, site.url).toString() : undefined;
const twitterCard = absoluteImage ? "summary_large_image" : "summary";
const jsonLdText = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : undefined;
const umamiWebsiteId = getUmamiWebsiteId(
  import.meta.env.PROD,
  import.meta.env.PUBLIC_UMAMI_WEBSITE_ID
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#18324a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/design-system.css?v=1" />
    {umamiWebsiteId && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={umamiWebsiteId}
      ></script>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href="/rss.xml" />
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname}>
      <slot name="header-actions" slot="header-actions" />
    </SiteHeader>
    <slot />
    <SiteFooter />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
