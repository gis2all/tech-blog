---
import { ArrowRight } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts, getAllSeries } from "../../lib/content/queries";
import { getSeriesPosts } from "../../lib/content/posts";

const posts = await getAllPosts();
const allSeries = await getAllSeries();
---

<BaseLayout title="专题" description="按主题整理的系列文章与实践路径。">
  <main class="wrap">
    <div class="page-head">
      <div>
        <h1>专题</h1>
        <p>按主题整理的系列文章与实践路径</p>
      </div>
    </div>
    <section class="series-grid">
      {allSeries.map((series) => {
        const count = getSeriesPosts(posts, series.data.slug).length;
        const seriesHref = `/series/${series.data.slug}/`;

        return (
          <article class="panel series-card">
            <a
              class="series-card-media"
              href={seriesHref}
              aria-label={`查看专题：${series.data.title}`}
            >
              <img
                src={series.data.image}
                alt={series.data.imageAlt}
                width="1440"
                height="810"
                loading="lazy"
              />
            </a>
            <div class="series-card-body">
              <h2 class="series-card-title">
                <a href={seriesHref}>{series.data.title}</a>
              </h2>
              <p class="series-card-description">{series.data.description}</p>
              <div class="series-card-footer">
                <span class="series-card-count">{`${count} 篇文章`}</span>
                <a class="series-card-action" href={seriesHref}>
                  <span>查看专题</span>
                  <ArrowRight size={15} aria-hidden="true" />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </section>
  </main>
</BaseLayout>
