---
import ArticleList from "../../components/article/ArticleList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPosts, getAllSeries } from "../../lib/content/queries";
import { getSeriesPosts } from "../../lib/content/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const allSeries = await getAllSeries();
  return allSeries.map((series) => ({
    params: { slug: series.data.slug },
    props: { series, posts: getSeriesPosts(posts, series.data.slug) }
  }));
}

const { series, posts } = Astro.props;
---

<BaseLayout title={series.data.title} description={series.data.description}>
  <main class="wrap">
    <div class="page-head">
      <div>
        <span class="kicker">SERIES</span>
        <h1>{series.data.title}</h1>
        <p>{series.data.description}</p>
      </div>
    </div>
    <section class="panel">
      <ArticleList posts={posts} />
    </section>
  </main>
</BaseLayout>
