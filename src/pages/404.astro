---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" description="这个页面不存在" noindex>
  <main id="main-content" class="wrap not-found">
    <div>
      <b>404</b>
      <h1>页面不存在</h1>
      <p>也许链接已经移动，或者文章还没有公开发布。</p>
      <a class="button primary" href="/">回到首页</a>
    </div>
  </main>
</BaseLayout>
