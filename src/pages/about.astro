---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthorAvatar from "../components/common/AuthorAvatar.astro";
import GithubIcon from "../components/common/GithubIcon.astro";
import { site } from "../lib/site";
---

<BaseLayout title="关于" description="关于知行和作者">
  <main class="wrap">
    <div class="page-head">
      <div>
        <h1>关于</h1>
        <p>{site.description}</p>
      </div>
    </div>
    <section class="panel about-page">
      <div class="prose">
        <h2>知行</h2>
        <p>吾日三省吾身，积少成多。</p>
        <h2>原则</h2>
        <ul>
          <li>真实记录</li>
          <li>过程比结果更重要</li>
          <li>举一反三</li>
        </ul>
        <h2>技术栈</h2>
        <p>Astro 负责生成静态页面，Decap CMS 提供网页写作后台，GitHub 保存内容，Netlify 负责构建和发布。</p>
      </div>
      <footer class="about-author" aria-label="作者信息">
        <div class="about-author-identity">
          <AuthorAvatar size="mini" />
          <div class="about-author-copy">
            <h2>{site.author}</h2>
            <p>{site.description}</p>
          </div>
        </div>
        <a class="button about-author-link" href="https://github.com/gis2all">
          <GithubIcon size={16} />
          <span>GitHub</span>
        </a>
      </footer>
    </section>
  </main>
</BaseLayout>
