---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPostSlug } from "../lib/content/posts";
import { getAllPosts } from "../lib/content/queries";

const posts = await getAllPosts();
const searchDocumentsJson = JSON.stringify(
  posts.map((post) => ({
    title: post.data.title,
    url: `/posts/${getPostSlug(post)}/`,
    description: post.data.description,
    category: post.data.category,
    tags: post.data.tags,
  })),
).replace(/</g, "\\u003c");
---

<BaseLayout title="搜索" description="搜索知行文章">
  <main class="wrap listing-grid">
    <section class="panel search-panel">
      <div class="page-head">
        <div>
          <h1>搜索</h1>
          <p id="search-summary">输入关键词后搜索文章、标签和正文</p>
        </div>
      </div>
      <form class="search-form" id="page-search-form">
        <input class="field grow" id="page-search-input" name="q" type="search" placeholder="例如：Astro、Agent、TypeScript" />
        <button class="button primary" type="submit">搜索</button>
      </form>
      <div id="search-results"></div>
      <script id="search-documents" type="application/json" is:inline set:html={searchDocumentsJson}></script>
    </section>
    <aside class="right-rail stack">
      <section class="panel">
        <div class="section-title">搜索说明</div>
        <div class="pad">
          <p>生产构建后由 Pagefind 生成静态索引。没有数据库，也不会把搜索词发送给第三方服务。</p>
        </div>
      </section>
    </aside>
  </main>
  <script>
    import "../scripts/search-page";
  </script>
</BaseLayout>
