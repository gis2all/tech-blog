---
import ArticleList from "../components/article/ArticleList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllPosts } from "../lib/content/queries";
import { groupPostsByCategory, groupPostsByTag } from "../lib/content/posts";
import { site } from "../lib/site";

const posts = await getAllPosts();
const featured = posts.filter((post) => post.data.featured);
const categories = groupPostsByCategory(posts);
const tags = groupPostsByTag(posts).slice(0, 12);
---

<BaseLayout>
  <main class="wrap home-grid">
    <aside class="left-rail stack">
      <section class="panel profile">
        <div class="avatar">{site.authorInitials}</div>
        <h2>{site.author}</h2>
        <p>{site.description}</p>
        <div class="stats">
          <div class="stat"><strong>{posts.length}</strong><span>文章</span></div>
          <div class="stat"><strong>{categories.length}</strong><span>分类</span></div>
          <div class="stat"><strong>{tags.length}</strong><span>标签</span></div>
        </div>
      </section>
      <section class="panel">
        <div class="section-title">技术分类 <small><a href="/categories/">全部</a></small></div>
        <div class="taxonomy-list">
          {categories.map((category) => (
            <a class="taxonomy-row" href={`/categories/${encodeURIComponent(category.name)}/`}>
              <span>{category.name}</span>
              <b>{category.count}</b>
            </a>
          ))}
        </div>
      </section>
    </aside>
    <section class="panel">
      <div class="section-title">最新文章 <small>共 {posts.length} 篇公开记录</small></div>
      <ArticleList posts={posts} />
    </section>
    <aside class="right-rail stack">
      <section class="panel">
        <div class="section-title">精选文章 <small>工程复盘</small></div>
        <ArticleList posts={featured} compact />
      </section>
      <section class="panel">
        <div class="section-title">标签云 <small>{tags.length} 个标签</small></div>
        <div class="tag-cloud">
          {tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag.name)}/`}>{tag.name}</a>)}
        </div>
      </section>
      <section class="panel pad">
        <span class="kicker">NOW</span>
        <h2>正在构建：静态优先博客</h2>
        <p>Astro 生成页面，Decap CMS 写作，GitHub 保存内容，Netlify 发布到 CDN。</p>
      </section>
    </aside>
  </main>
</BaseLayout>
