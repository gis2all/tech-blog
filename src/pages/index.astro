---
import ArticleList from "../components/article/ArticleList.astro";
import DiscoveryRail from "../components/layout/DiscoveryRail.astro";
import FeaturedTagRail from "../components/layout/FeaturedTagRail.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllPosts, getAllSeries } from "../lib/content/queries";

const posts = await getAllPosts();
const allSeries = await getAllSeries();
---

<BaseLayout>
  <main class="wrap home-grid">
    <DiscoveryRail posts={posts} allSeries={allSeries} mode="home" />
    <section class="panel home-feed">
      <div class="section-title home-feed-head">
        <h1 data-home-feed-title>最新文章</h1>
        <small data-home-feed-count>共 {posts.length} 篇公开记录</small>
      </div>
      <ArticleList posts={posts} showCategory={false} tagLimit={2} />
      <p class="article-filter-empty" data-home-filter-empty hidden>该筛选下暂无文章</p>
    </section>
    <FeaturedTagRail posts={posts} />
  </main>
</BaseLayout>

<script>
  import "../scripts/home-category-filter";
</script>
