{
  "name": "zhixing-tech-blog",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "cms:local": "node scripts/start-decap-server.mjs",
    "build": "astro build",
    "postbuild": "node scripts/generate-thumbnails.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:admin": "tsc -p tsconfig.admin.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "perf": "node scripts/run-lighthouse.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:badge": "node scripts/generate-coverage-badge.mjs",
    "test:e2e": "playwright test",
    "skill:install": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.3.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@lucide/astro": "1.27.0",
    "astro": "7.1.4",
    "pagefind": "1.5.2",
    "sharp": "0.35.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "decap-server": "3.10.0",
    "lighthouse": "13.4.1",
    "pinyin-pro": "3.28.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
